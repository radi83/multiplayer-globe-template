{
  "name": "bmms-kongre-site",
  "private": true,
  "version": "1.0.0",
  "description": "BMMS — Maritime Engineering Knowledge System: kongre tanıtım sitesi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  }
}
